{
    "name": "NVIDIA PyTorch RAG Development",
    
    // 1. Point to your preferred NGC container image
    "image": "nvcr.io/nvidia/pytorch:25.03-py3",

    // 2. Pass command line flags directly to the Docker engine
    "runArgs": [
        "--gpus=all",        // Enables all host GPUs inside the editor
        "--ipc=host"         // Optimized shared memory allocation for PyTorch loaders
    ],

    // 3. Automatically inject required VS Code extensions inside the container
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",          // Full Python core support
                "ms-python.vscode-pylance",   // Fast semantic code tracking
                "ms-toolsai.jupyter"          // Allows running .ipynb files directly in VS Code UI
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },

    // 4. Automatically expose ports (e.g., if you spin up Streamlit or a local database)
    "forwardPorts": [8888, 8501],

    // 5. Run standard shell commands inside the container after assembly completes
    "postCreateCommand": "pip install chromadb pandas sentence-transformers"
}